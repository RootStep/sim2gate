# Copy to .env and adjust. docker compose reads this file automatically;
# build.sh sources it too.

# Absolute path to the IsaacLab-Arena clone on the host. Bind-mounted at
# /workspaces/isaaclab_arena, so edits in VS Code are edits to this checkout.
# Its submodules must be initialised (git submodule update --init --recursive).
ARENA_REPO=/home/ubuntu/IsaacLab-Arena

# Host user identity, used by the Arena entrypoint to recreate the same user
# inside the container so bind-mounted files keep the right ownership.
# On the instance: HOST_UID=$(id -u), HOST_USER=$(id -un), etc.
HOST_UID=1000
HOST_GID=1000
HOST_USER=ubuntu
HOST_GROUP=ubuntu

# Host directories mounted at /datasets, /models and /eval.
DATASETS_DIR=/home/ubuntu/datasets
MODELS_DIR=/home/ubuntu/models
EVAL_DIR=/home/ubuntu/eval

# How the web viewer resolves the WebRTC media server address:
#   brev      - the instance's public IP (correct for a cloud launchable)
#   localhost - 127.0.0.1 (running this stack on your own machine)
#   instance  - resolve the container hostname
VIEWER_ENV=brev

# code-server password. Leave unset when fronting the stack with a Brev Secure
# Link, which authenticates the link itself.
# VSCODE_PASSWORD=

# Image the vscode service layers code-server onto. Built by build.sh.
# ARENA_IMAGE=isaaclab_arena:latest
